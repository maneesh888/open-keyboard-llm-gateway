#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! git -C "$ROOT" diff --quiet || [[ -n "$(git -C "$ROOT" ls-files --others --exclude-standard)" ]]; then
  echo "Pre-commit requires all intended worktree changes to be staged." >&2
  exit 1
fi

SCOPE="$("$ROOT/scripts/select-verification-scope.sh" --staged)"
case "$SCOPE" in
  docs) "$ROOT/scripts/check.sh" --hygiene ;;
  full) "$ROOT/scripts/check.sh" --quick ;;
  *) exit 1 ;;
esac
