{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "API gateway for Ollama with API key auth, rate limiting, and logging",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev:bootstrap": "node scripts/bootstrap.mjs --serve",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node scripts/secret-scan.mjs",
    "docker:preflight": "node scripts/docker-base-preflight.mjs",
    "docker:smoke": "./scripts/docker-smoke.sh",
    "check:hygiene": "./scripts/check.sh --hygiene",
    "check:quick": "./scripts/check.sh --quick",
    "check:full": "./scripts/check.sh --full",
    "precommit": "./scripts/check.sh --quick"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.12",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
